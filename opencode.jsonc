{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "docker-gateway": {
        "type": "remote",
        "url": "http://127.0.0.1:8811/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:MCP_GATEWAY_AUTH_TOKEN}",
        },
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "postman-full": {
        "type": "local",
        "command": ["bash", "scripts/run-postman-mcp-full.sh", "--full"]
      },
    },
  },
}
