# Copy to .env and fill in real values. Never commit .env.
#
# OpenCode and the gateway must use the same token:
#   export MCP_GATEWAY_AUTH_TOKEN='...'
MCP_GATEWAY_AUTH_TOKEN=change-me-to-a-long-random-token

# Postman API key (https://go.postman.co/settings/me/api-keys)
postman.postman-api-key=PMAK-replace-me

# Optional: the standalone Postman full server (scripts/setup-postman-mcp.sh)
# reads the key above. OpenCode's postman-full entry uses
# scripts/run-postman-mcp-full.sh, which reads the same key.
